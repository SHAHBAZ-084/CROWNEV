DATABASE_URL="postgresql://postgres:password@localhost:5432/crown_eve?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
OTP_EXPIRY_MINUTES=10
PORT=3001
NODE_ENV=development

# Email (Nodemailer + Resend/Brevo SMTP)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="your-api-key"
EMAIL_FROM="noreply@crown-eve.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"

# File uploads (local dev; Cloudflare R2 in production)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
