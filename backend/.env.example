DATABASE_URL="postgresql://postgres:password@localhost:5432/crown_eve?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
OTP_EXPIRY_MINUTES=10
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

# Email — Resend SMTP (https://resend.com/api-keys)
# Local dev: use onboarding@resend.dev (no domain verification). Get API key from Resend dashboard.
# Resend sandbox only delivers to YOUR Resend account email until domain is verified.
# Production VPS: set EMAIL_FROM=contact@crownevcenter.com after crownevcenter.com is verified in Resend.
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_YOUR_API_KEY"
EMAIL_FROM="onboarding@resend.dev"

# Contact form notifications delivered here
CONTACT_INBOX_EMAIL="contact@crownevcenter.com"
# Optional dev fallback when Resend sandbox blocks the inbox (your Resend signup email)
CONTACT_DEV_INBOX_EMAIL=""

# Production (after crownevcenter.com verified in Resend):
# EMAIL_FROM="contact@crownevcenter.com"
# CONTACT_INBOX_EMAIL="contact@crownevcenter.com"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"

# File uploads (local dev; Cloudflare R2 in production)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5
